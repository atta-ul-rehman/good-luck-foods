# ============================================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# --- MongoDB Atlas ---
# Get this from: https://cloud.mongodb.com -> Connect -> Drivers
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/goodluckfoods?retryWrites=true&w=majority

# --- JWT ---
# Use a long random string (32+ characters). Generate one at: https://generate-secret.vercel.app/64
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# --- Email (Nodemailer) ---
# For Gmail: use an App Password (not your real password)
# Go to: Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# The email address that receives contact form submissions
ADMIN_EMAIL=admin@goodluckfoods.co.uk

# --- CORS ---
# Your frontend domain (no trailing slash)
# Example: https://www.goodluckfoods.co.uk
CLIENT_ORIGIN=https://www.goodluckfoods.co.uk

# --- Server Port ---
# Hostinger VPS may assign a port or you can pick one (default 5000)
PORT=5000
